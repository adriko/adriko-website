---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sections = ['database', 'gear', 'hardware', 'software'] as const;

  return sections.map((section) => ({
    params: { section },
    props: { section },
  }));
}

const { section } = Astro.props;

const rawEntries = await getCollection(section as any).catch(() => []);
const entries = [...rawEntries].sort(
  (a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const getSlug = (entry: any) => entry.slug || entry.id.replace(/\.[^/.]+$/, '');

const getExtension = (sec: string) => {
  switch (sec) {
    case 'database': return '.dat';
    case 'gear': return '.loadout';
    case 'hardware': return '.spec';
    case 'software': return '.sys';
    default: return '.dat';
  }
};
const ext = getExtension(section);

const sectionDescriptions: Record<string, string> = {
  database: 'ARCHIWUM WIEDZY, DOKUMENTACJA, RAPORTY I BAZA TECHNOLOGICZNA.',
  gear: 'TAKTYCZNY EKWIPUNEK, MASZYNY, PROJEKTY MOTORYZACYJNE I STRZELECTWO.',
  hardware: 'ARCHITEKTURA KRZEMOWA, PODZESPOŁY, RETRO PECETY I MODYFIKACJE.',
  software: 'SYSTEMY OPERACYJNE, PROGRAMOWANIE, SKRYPTY ORAZ INŻYNIERIA OPROGRAMOWANIA.',
};
const sectionDesc = sectionDescriptions[section] || 'SEKTOR DANYCH CYFROWYCH.';
---

<BaseLayout title={`adriko // [./${section}]`} activeNav={section as any}>
  <section style="margin-bottom: 1.5rem;">
    <h2 style="margin-bottom: 0.5rem; color: #fff; font-size: 1.25rem; letter-spacing: 0.05em;">
      [ SECTOR // ./{section.toUpperCase()} ]
    </h2>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <p style="color: #777; font-size: 0.82rem; margin: 0; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span>STATUS: <span style="color: #5ab35a; font-weight: bold; text-shadow: 0 0 6px rgba(90, 179, 90, 0.45);">ONLINE</span></span>
        <span style="color: #331515;">|</span>
        <span>INDEXED_RECORDS: <span style="color: #fff; font-weight: bold;">{entries.length}</span></span>
        <span style="color: #331515;">|</span>
        <span id="system-clock" style="color: #aa4444; font-weight: 600;">[UTC --:--:--]</span>
        <span style="color: #331515;">|</span>
        <span id="session-uptime" style="color: #aa4444; font-weight: 600;">[UPTIME 00:00:00]</span>
      </p>

      <div style="display: flex; gap: 0.5rem;">
        <button id="view-cards-btn" class="btn-terminator active" style="padding: 2px 8px; font-size: 0.75rem;">
          [VIEW: CARDS]
        </button>
        <button id="view-tree-btn" class="btn-terminator" style="padding: 2px 8px; font-size: 0.75rem;">
          [VIEW: TREE]
        </button>
      </div>
    </div>
    <p style="color: #8c5252; font-size: 0.8rem; margin: 0.6rem 0 0 0; letter-spacing: 0.04em;">
      // {sectionDesc}
    </p>
  </section>

  <!-- TERMINAL CLI Z KURSOREM █ -->
  <div class="grep-wrapper">
    <div class="grep-prefix">
      <span class="grep-prompt-user">operator@adriko</span>:<span class="grep-prompt-path">~/{section}</span>$ <span class="grep-cmd">sh:</span><span class="cli-block-cursor" aria-hidden="true">█</span>
    </div>
    <input 
      type="text" 
      id="cli-input" 
      class="grep-input" 
      placeholder="Type search pattern or command ('help', 'origin', 'specs', 'weather', 'crypto btc')..." 
      autocomplete="off"
      spellcheck="false"
    />
    <button id="cli-clear-btn" class="grep-clear-btn" type="button">[ESC / CLEAR]</button>
  </div>

  <div id="cli-output" class="cli-terminal-window" style="display: none;">
    <div class="cli-terminal-header">
      <span class="cli-terminal-title">[ TTY_OUTPUT // EXEC_RESULT ]</span>
      <button id="cli-output-close" class="cli-close-btn" type="button">[X]</button>
    </div>
    <div id="cli-output-content" class="cli-terminal-body"></div>
  </div>

  <div id="grep-status" class="grep-status-bar"></div>

  <!-- WIDOK 1: KARTY -->
  <div id="cards-view">
    <div style="display: flex; flex-direction: column; gap: 1.15rem;">
      {entries.map((entry: any) => {
        const slug = getSlug(entry);
        const url = `/${section}/${slug}`;
        const searchPayload = `${entry.data.title} ${entry.data.description || ''} ${(entry.data.tags || []).join(' ')} ${section} ${slug}`.toLowerCase();
        
        return (
          <article 
            class="terminal-card post-card-item" 
            data-search={searchPayload}
            style="padding: 1.15rem;"
          >
            <!-- SYNTAKTYCZNA BELKA METADANYCH (DIR + TIMESTAMP) -->
            <div style="font-size: 0.78rem; letter-spacing: 0.05em; margin-bottom: 0.45rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span style="color: #ff3333; font-weight: 600;">DIR: ./{section}/</span>
              <span style="color: #441a1a;">//</span>
              <span style="color: #8e5252;">TIMESTAMP: [{entry.data.date}]</span>
            </div>

            <h3 style="margin: 0.4rem 0 0.45rem 0;">
              <a href={url} style="color: #ffffff; font-size: 1.15rem; display: inline-block;">
                &gt; {entry.data.title}
              </a>
            </h3>

            {entry.data.description && (
              <p style="color: #999; font-size: 0.88rem; margin: 0 0 0.65rem 0; line-height: 1.5;">
                {entry.data.description}
              </p>
            )}

            <!-- SYNTAKTYCZNA SEKCJA TAGÓW -->
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.45rem; font-size: 0.76rem; letter-spacing: 0.04em;">
                <span style="color: #664444; font-weight: 600;">TAGS:</span>
                {entry.data.tags.map((tag: string) => (
                  <span style="color: #8c5252;">[{tag}]</span>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>

  <!-- WIDOK 2: DRZEWO UNIX -->
  <div id="tree-view" class="tree-container" style="display: none;">
    <div class="tree-root">
      &gt; /sys/root/{section}/
    </div>

    <div style="margin-left: 1.15rem; display: flex; flex-direction: column; gap: 0.25rem;">
      {entries.length === 0 ? (
        <div style="color: #6e3535; font-style: italic; font-size: 0.8rem; padding: 0.2rem 0.5rem; white-space: nowrap;">
          └── [EMPTY_CATALOG]
        </div>
      ) : (
        entries.map((item: any, iIdx: number) => {
          const isLastItem = iIdx === entries.length - 1;
          const slug = getSlug(item);
          const url = `/${section}/${slug}`;
          const searchPayload = `${item.data.title} ${item.data.description || ''} ${(item.data.tags || []).join(' ')} ${section} ${slug}`.toLowerCase();

          return (
            <a 
              href={url} 
              class="tree-item post-tree-item"
              data-search={searchPayload}
            >
              <span class="tree-branch">{isLastItem ? '└──' : '├──'}</span>
              <span class="tree-date">[{item.data.date}]</span>
              <span class="tree-filename">{slug}{ext}</span>
              <span class="tree-comment">// {item.data.title}</span>
            </a>
          );
        })
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .cli-terminal-window {
    background: #070404;
    border: 1px solid #ff1a1a;
    box-shadow: 0 0 20px rgba(255, 26, 26, 0.2);
    margin-bottom: 2rem;
    border-radius: 2px;
    overflow: hidden;
  }

  .cli-terminal-header {
    background: #140707;
    border-bottom: 1px solid #331212;
    padding: 0.4rem 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
  }

  .cli-terminal-title {
    color: #ff4d4d;
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .cli-close-btn {
    background: transparent;
    border: none;
    color: #885555;
    font-family: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .cli-close-btn:hover {
    color: #ff1a1a;
  }

  .cli-terminal-body {
    padding: 1rem;
    font-size: 0.84rem;
    line-height: 1.6;
    color: #d8d8d8;
    white-space: pre-wrap;
    font-family: var(--mono-font-stack);
  }
</style>

<script is:inline>
  let sessionStart = sessionStorage.getItem('adriko_session_start');
  if (!sessionStart) {
    sessionStart = Date.now().toString();
    sessionStorage.setItem('adriko_session_start', sessionStart);
  }
  const startTime = parseInt(sessionStart, 10);

  function updateTelemetry() {
    const clockEl = document.getElementById('system-clock');
    const uptimeEl = document.getElementById('session-uptime');
    const now = new Date();

    if (clockEl) {
      const utcTime = now.toTimeString().split(' ')[0];
      clockEl.textContent = `[UTC ${utcTime}]`;
    }

    if (uptimeEl) {
      const elapsedSec = Math.max(0, Math.floor((Date.now() - startTime) / 1000));
      const hours = String(Math.floor(elapsedSec / 3600)).padStart(2, '0');
      const mins = String(Math.floor((elapsedSec % 3600) / 60)).padStart(2, '0');
      const secs = String(elapsedSec % 60).padStart(2, '0');
      uptimeEl.textContent = `[UPTIME ${hours}:${mins}:${secs}]`;
    }
  }
  updateTelemetry();
  setInterval(updateTelemetry, 1000);

  const cardsView = document.getElementById('cards-view');
  const treeView = document.getElementById('tree-view');
  const btnCards = document.getElementById('view-cards-btn');
  const btnTree = document.getElementById('view-tree-btn');

  function setView(mode) {
    if (mode === 'tree') {
      if (cardsView) cardsView.style.display = 'none';
      if (treeView) treeView.style.display = 'block';
      btnTree?.classList.add('active');
      btnCards?.classList.remove('active');
    } else {
      if (cardsView) cardsView.style.display = 'block';
      if (treeView) treeView.style.display = 'none';
      btnCards?.classList.add('active');
      btnTree?.classList.remove('active');
    }
    sessionStorage.setItem('adriko_website_view', mode);
  }

  btnCards?.addEventListener('click', () => setView('cards'));
  btnTree?.addEventListener('click', () => setView('tree'));

  setView(sessionStorage.getItem('adriko_website_view') || 'cards');

  const cliInput = document.getElementById('cli-input');
  const cliClear = document.getElementById('cli-clear-btn');
  const grepStatus = document.getElementById('grep-status');
  const cliOutput = document.getElementById('cli-output');
  const cliOutputContent = document.getElementById('cli-output-content');
  const cliOutputClose = document.getElementById('cli-output-close');

  cliOutputClose?.addEventListener('click', () => {
    cliOutput.style.display = 'none';
  });

  const cmdHistory = [];
  let historyIdx = -1;

  function runGrep(query) {
    const raw = query.trim();
    let term = raw.toLowerCase();

    if (term === 'grep' || term === 'grep ') {
      cliClear.style.display = 'inline-block';
      grepStatus.style.display = 'block';
      grepStatus.textContent = '// GREP: TYPE PATTERN TO FILTER...';
      grepStatus.style.color = '#cc8833';
      document.querySelectorAll('.post-card-item').forEach((item) => { item.style.display = 'block'; });
      document.querySelectorAll('.post-tree-item').forEach((item) => { item.style.display = 'flex'; });
      return;
    }

    if (term.startsWith('grep ')) {
      term = term.slice(5).trim();
    }

    let matchesCount = 0;

    if (term.length > 0) {
      cliClear.style.display = 'inline-block';
    } else {
      cliClear.style.display = 'none';
      grepStatus.style.display = 'none';
    }

    document.querySelectorAll('.post-card-item').forEach((item) => {
      const text = item.getAttribute('data-search') || '';
      const match = !term || text.includes(term);
      item.style.display = match ? 'block' : 'none';
      if (match) matchesCount++;
    });

    document.querySelectorAll('.post-tree-item').forEach((item) => {
      const text = item.getAttribute('data-search') || '';
      const match = !term || text.includes(term);
      item.style.display = match ? 'flex' : 'none';
    });

    if (term.length > 0) {
      grepStatus.style.display = 'block';
      if (matchesCount > 0) {
        grepStatus.textContent = `// GREP: ${matchesCount} RECORD(S) MATCHED FOR "${term}"`;
        grepStatus.style.color = '#77aa77';
      } else {
        grepStatus.textContent = `// GREP_STATUS: 0 RECORDS MATCHED FOR "${term}"`;
        grepStatus.style.color = '#aa4444';
      }
    }
  }

  async function executeCommand(cmdStr) {
    const raw = cmdStr.trim();
    if (!raw) return;

    cmdHistory.push(raw);
    historyIdx = cmdHistory.length;

    const parts = raw.split(/\s+/);
    const command = parts[0].toLowerCase();
    const arg = parts.slice(1).join(' ').trim();

    cliOutput.style.display = 'block';

    switch (command) {
      case 'help':
        cliOutputContent.textContent = 
`[ COMMAND REGISTRY // SECTOR CLI ]
----------------------------------------------------------------------
whoami            : Operator profile & active technology stack
origin            : Genesis log & background story of adriko.net
specs             : Hardware & browser diagnostics probe
weather [city]    : Orbital weather telemetry (defaults to Jarosław base)
crypto <symbol>   : Realtime crypto exchange feed via Binance
fx <currency>     : Official fiat exchange rate via NBP
ping [target]     : Probe latency round-trip time
clear             : Flush console output and reset filters`;
        break;

      case 'origin':
        cliOutputContent.textContent = '// ACCESSING SYSTEM GENESIS RECORD...';
        setTimeout(() => { window.location.href = '/software/skad-sie-wzial-adriko-net'; }, 250);
        break;

      case 'clear':
        cliOutput.style.display = 'none';
        cliInput.value = '';
        runGrep('');
        break;

      default:
        cliOutput.style.display = 'none';
        runGrep(raw);
        break;
    }
  }

  cliInput?.addEventListener('input', (e) => {
    runGrep(e.target.value);
  });

  cliInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      executeCommand(cliInput.value);
    } else if (e.key === 'Escape') {
      cliInput.value = '';
      runGrep('');
      cliOutput.style.display = 'none';
    }
  });

  cliClear?.addEventListener('click', () => {
    cliInput.value = '';
    runGrep('');
    cliOutput.style.display = 'none';
    cliInput.focus();
  });
</script>