---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  activeNav?: 'database' | 'hardware' | 'software' | 'gear' | 'index';
}

const { title = 'adriko // SYSTEM_HUB', activeNav = 'index' } = Astro.props;

// Pobranie rzeczywistej liczby wpisów w kolekcjach na poziomie serwera
const dbEntries = await getCollection('database').catch(() => []);
const hwEntries = await getCollection('hardware').catch(() => []);
const swEntries = await getCollection('software').catch(() => []);
const gearEntries = await getCollection('gear').catch(() => []);

const counts = {
  database: dbEntries.length,
  hardware: hwEntries.length,
  software: swEntries.length,
  gear: gearEntries.length
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="adriko.net // Cyfrowy bunkier, retro-futurystyczny terminal, baza wiedzy i archiwum technologiczne." />
    
    <!-- Ikona SVG -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    
    <!-- Import Google Fonts: JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="terminal">
    <!-- RETRO BIOS / KERNEL BOOT OVERLAY -->
    <div id="boot-screen" class="boot-overlay" data-counts={JSON.stringify(counts)}>
      <div class="boot-header-bar">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <!-- Powiększone logo w ekranie BIOS -->
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#ff1a1a"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="filter: drop-shadow(0 0 5px rgba(255, 26, 26, 0.75)); flex-shrink: 0;"
          >
            <path d="M5 4 L7 10 L3 12 L7 16 L12 21 L17 16 L21 12 L17 10 L19 4 L14 7 L12 5 L10 7 Z" />
            <line x1="7" y1="11" x2="10" y2="12" />
            <line x1="17" y1="11" x2="14" y2="12" />
          </svg>
          <span style="color: #ff3333; font-weight: bold; letter-spacing: 0.05em;">[ADRIKO BIOS // v4.02]</span>
          <span id="boot-status-msg" style="color: #aa5555; font-size: 0.8rem;">[SPACE/TAP: PAUSE | ESC: SKIP]</span>
        </div>
        <button id="boot-skip-btn" class="boot-skip-trg" type="button">[SKIP / ESC]</button>
      </div>
      <div id="boot-log" class="boot-terminal-body"></div>
    </div>

    <div class="container">
      <header class="terminal-nav">
        <a href="/" class="brand">
          <!-- Logo T-800 Hunter -->
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#ff1a1a"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            style="filter: drop-shadow(0 0 6px rgba(255, 26, 26, 0.75)); display: block; flex-shrink: 0;"
          >
            <path d="M5 4 L7 10 L3 12 L7 16 L12 21 L17 16 L21 12 L17 10 L19 4 L14 7 L12 5 L10 7 Z" />
            <line x1="7" y1="11" x2="10" y2="12" />
            <line x1="17" y1="11" x2="14" y2="12" />
          </svg>
          <span style="font-size: 1.15rem; font-weight: 700; color: #ffffff; letter-spacing: 0.05em; text-shadow: 0 0 4px rgba(255, 26, 26, 0.35); white-space: nowrap;">adriko</span>
        </a>

        <!-- Systemowa nawigacja po katalogach -->
        <nav class="nav-right" aria-label="Nawigacja systemowa">
          <ul class="nav-links">
            <li>
              <a href="/database" class={activeNav === 'database' ? 'active' : ''}>[./database]</a>
            </li>
            <li>
              <a href="/hardware" class={activeNav === 'hardware' ? 'active' : ''}>[./hardware]</a>
            </li>
            <li>
              <a href="/software" class={activeNav === 'software' ? 'active' : ''}>[./software]</a>
            </li>
            <li>
              <a href="/gear" class={activeNav === 'gear' ? 'active' : ''}>[./gear]</a>
            </li>
          </ul>
        </nav>
      </header>

      <main style="flex: 1 0 auto;">
        <slot />
      </main>

      <!-- Stopka taktyczna HUD -->
      <footer class="tactical-footer">
        <div class="hud-container">
          <span class="hud-item">[ HUB // ADRIKO.NET ]</span>
          <span class="hud-sep">::</span>
          <span class="hud-item" id="hud-solar">SOLAR: ↑06:51 ↓17:46</span>
          <span class="hud-sep">::</span>
          <span class="hud-item" id="hud-luna">LUNA: WAX_GIB [84%]</span>
          <span class="hud-sep">::</span>
          <span class="hud-item">GRID: 50.0197° N, 22.6781° E</span>
          <span class="hud-sep">::</span>
          <span class="hud-item">SYS_HUB v2.0</span>
        </div>
      </footer>
    </div>

    <style>
      /* Styl nakładki rozruchowej BIOS / Kernel */
      .boot-overlay {
        position: fixed;
        inset: 0;
        background: #040202;
        color: #ff3333;
        font-family: var(--font-stack);
        z-index: 9999999;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        overflow-y: auto;
        cursor: pointer; /* Wskazuje, że ekran reaguje na dotknięcie/kliknięcie */
      }

      .boot-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #331212;
        padding-bottom: 0.8rem;
        margin-bottom: 1.25rem;
        font-size: 1rem;
        letter-spacing: 0.03em;
        color: #ff4d4d;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .boot-skip-trg {
        background: #1a0808;
        border: 1px solid #ff1a1a;
        color: #ff3333;
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: bold;
        padding: 6px 12px;
        cursor: pointer;
        box-shadow: 0 0 8px rgba(255, 26, 26, 0.3);
        transition: all 0.15s ease;
      }

      .boot-skip-trg:hover {
        background: #ff1a1a;
        color: #060606;
        box-shadow: 0 0 14px rgba(255, 26, 26, 0.7);
      }

      .boot-terminal-body {
        font-size: 0.82rem;
        line-height: 1.6;
        white-space: pre-wrap;
        color: #d0d0d0;
        max-width: 1200px;
        word-break: break-word;
      }

      /* Desktop / Monitory 2K / 4K */
      @media (min-width: 768px) {
        .boot-overlay {
          padding: 3rem 4rem;
        }
        .boot-header-bar {
          font-size: 1.35rem;
          padding-bottom: 1rem;
          margin-bottom: 2rem;
        }
        .boot-skip-trg {
          font-size: 0.95rem;
          padding: 8px 16px;
        }
        .boot-terminal-body {
          font-size: 1.1rem;
          line-height: 1.75;
          word-break: normal;
        }
      }
    </style>

    <script is:inline>
      // Logika sekwencji rozruchowej BIOS / Kernel z obsługą tapnięcia na mobile
      (function() {
        const bootScreen = document.getElementById('boot-screen');
        const bootLog = document.getElementById('boot-log');
        const skipBtn = document.getElementById('boot-skip-btn');
        const statusMsg = document.getElementById('boot-status-msg');

        let counts = { database: 0, hardware: 0, software: 0, gear: 0 };
        try {
          if (bootScreen && bootScreen.dataset.counts) {
            counts = JSON.parse(bootScreen.dataset.counts);
          }
        } catch (e) {}

        const now = new Date();
        const lat = 50.0197;
        const lng = 22.6781;
        const rad = Math.PI / 180;
        const startYear = new Date(now.getFullYear(), 0, 0);
        const diffDaysOfYear = Math.floor((now.getTime() - startYear.getTime() + (startYear.getTimezoneOffset() - now.getTimezoneOffset()) * 60000) / 86400000);
        const gamma = (2 * Math.PI / 365) * (diffDaysOfYear - 1 + (now.getHours() - 12) / 24);
        const eqtime = 229.18 * (0.000075 + 0.001868 * Math.cos(gamma) - 0.032077 * Math.sin(gamma) - 0.014615 * Math.cos(2 * gamma) - 0.040849 * Math.sin(2 * gamma));
        const decl = 0.006918 - 0.399912 * Math.cos(gamma) + 0.070257 * Math.sin(gamma) - 0.006758 * Math.cos(2 * gamma) + 0.000907 * Math.sin(2 * gamma) - 0.002697 * Math.cos(3 * gamma) + 0.00148 * Math.sin(3 * gamma);
        const cosH = (Math.cos(90.833 * rad) - Math.sin(lat * rad) * Math.sin(decl)) / (Math.cos(lat * rad) * Math.cos(decl));
        
        let solarStr = "SOLAR: CALIBRATING...";
        if (cosH >= -1 && cosH <= 1) {
          const H = Math.acos(cosH) / rad;
          const solarNoonUTC = 720 - (4 * lng) - eqtime;
          const tzOffset = -now.getTimezoneOffset();
          const sr = (solarNoonUTC - (H * 4) + tzOffset + 1440) % 1440;
          const ss = (solarNoonUTC + (H * 4) + tzOffset + 1440) % 1440;
          const pad = (n) => String(Math.floor(n)).padStart(2, '0');
          solarStr = `SOLAR: ↑${pad(sr / 60)}:${pad(sr % 60)} ↓${pad(ss / 60)}:${pad(ss % 60)}`;
        }

        const refNewMoon = Date.UTC(2000, 0, 6, 18, 14, 0);
        const cycleFraction = (((now.getTime() - refNewMoon) / 86400000) % 29.53058867 + 29.53058867) % 29.53058867 / 29.53058867;
        const ill = Math.round(((1 - Math.cos(2 * Math.PI * cycleFraction)) / 2) * 100);
        let phase = 'WAX_GIB';
        if (cycleFraction >= 0.47 && cycleFraction < 0.53) phase = 'FULL_MOON';
        else if (cycleFraction >= 0.03 && cycleFraction < 0.22) phase = 'WAX_CRES';

        if (sessionStorage.getItem('adriko_booted') === 'true') {
          if (bootScreen) bootScreen.style.display = 'none';
        } else {
          const bootSequence = [
            { text: "CPU: VIRTUAL RISC-V CORE @ 4.2 GHz // ARCH: x86_64-UNIX", delay: 230, color: "#ff3333" },
            { text: "BIOS MEMORY CHECK: 131072 KB RAM OK [0 ERROR(S)]", delay: 240 },
            { text: "INITIALIZING BUS & STORAGE CONTROLLERS... [DONE]", delay: 240 },
            { text: "MOUNTING VIRTUAL FILESYSTEM /sys/root/...", delay: 280 },
            { text: ` -> SCANNING ./database [RECORDS: ${counts.database}] ... [OK]`, delay: 200 },
            { text: ` -> SCANNING ./hardware [RECORDS: ${counts.hardware}] ... [OK]`, delay: 200 },
            { text: ` -> SCANNING ./software [RECORDS: ${counts.software}] ... [OK]`, delay: 200 },
            { text: ` -> SCANNING ./gear     [RECORDS: ${counts.gear}]     ... [OK]`, delay: 220 },
            { text: "ESTABLISHING ORBITAL TELEMETRY LINK...", delay: 260 },
            { text: ` -> TARGET GRID: 50.0197° N, 22.6781° E [JAROSŁAW, PL]`, delay: 200 },
            { text: ` -> ENVIRONMENTAL: ${solarStr} // LUNA: ${phase} [${ill}%]`, delay: 240 },
            { text: ` -> STATUS: SECURE TLS 1.3 CONNECTION // ADRIKO.NET ONLINE`, delay: 240 },
            { text: "LOADING USER PROFILE: OPERATOR@ADRIKO", delay: 200 },
            { text: "ALL SUBSYSTEMS NOMINAL. LAUNCHING TTY HUD INTERFACE...\n", delay: 320 },
            { text: ">>> SYSTEM READY. WELCOME BACK, OPERATOR.", delay: 400, color: "#ffffff" }
          ];

          let currentLine = 0;
          let isPaused = false;
          let timerId = null;

          function finishBoot() {
            if (timerId) clearTimeout(timerId);
            sessionStorage.setItem('adriko_booted', 'true');
            if (bootScreen) {
              bootScreen.style.opacity = '0';
              bootScreen.style.transition = 'opacity 0.35s ease-out';
              setTimeout(() => {
                bootScreen.style.display = 'none';
              }, 350);
            }
          }

          function togglePause() {
            isPaused = !isPaused;
            if (statusMsg) {
              if (isPaused) {
                statusMsg.textContent = "[SYSTEM PAUSED - TAP/SPACE TO RESUME]";
                statusMsg.style.color = "#ffaa00";
              } else {
                statusMsg.textContent = "[SPACE/TAP: PAUSE | ESC: SKIP]";
                statusMsg.style.color = "#aa5555";
                runSequence();
              }
            }
          }

          skipBtn?.addEventListener('click', (e) => {
            e.stopPropagation(); // Zapobiega wywołaniu pauzy przy pomijaniu
            finishBoot();
          });

          // Obsługa kliknięcia/dotknięcia ekranu w celu pauzy (działa na telefonach i PC)
          bootScreen?.addEventListener('click', (e) => {
            togglePause();
          });

          window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              finishBoot();
            } else if (e.key === ' ' || e.code === 'Space') {
              e.preventDefault();
              togglePause();
            }
          });

          function runSequence() {
            if (isPaused) return;

            if (currentLine >= bootSequence.length) {
              timerId = setTimeout(finishBoot, 800);
              return;
            }

            const item = bootSequence[currentLine];
            const lineEl = document.createElement('div');
            if (item.color) lineEl.style.color = item.color;
            lineEl.textContent = item.text;
            bootLog?.appendChild(lineEl);
            
            if (bootScreen) bootScreen.scrollTop = bootScreen.scrollHeight;

            currentLine++;
            timerId = setTimeout(runSequence, item.delay);
          }

          timerId = setTimeout(runSequence, 250);
        }

        if (!sessionStorage.getItem('adriko_session_start')) {
          sessionStorage.setItem('adriko_session_start', Date.now().toString());
        }

        const solarEl = document.getElementById('hud-solar');
        if (solarEl && solarStr !== "SOLAR: CALIBRATING...") {
          solarEl.textContent = solarStr;
        }

        const lunaEl = document.getElementById('hud-luna');
        if (lunaEl) {
          lunaEl.textContent = `LUNA: ${phase} [${ill}%]`;
        }
      })();
    </script>
  </body>
</html>